# Normalize line endings: Windows checkouts stay working, Linux deploys stay working.
* text=auto
# Shell scripts MUST be LF or #!/bin/... breaks on Linux hosts.
*.sh text eol=lf
*.bash text eol=lf
Caddyfile text eol=lf
# Keep Windows batch files CRLF-safe (harmless either way, explicit beats sorry).
*.bat text eol=crlf
# Binary outputs — never normalize, rarely commit.
*.pdf binary
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.heic binary
*.heif binary
*.ico binary
